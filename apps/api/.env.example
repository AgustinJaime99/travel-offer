# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
API_PORT=3001
# Matches docker-compose.yml (POSTGRES_DEV_PORT, default 5440). Local-only credentials.
DATABASE_URL=postgresql://travelrock:travelrock@localhost:5440/travelrock
# Development-only value (rejected when NODE_ENV=production). Generate a real one with: openssl rand -base64 48
AUTH_HMAC_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
# Browser origins allowed to send state-changing requests (comma-separated).
WEB_ORIGINS=http://localhost:3000
# Express trust proxy setting. The Next.js server proxies /api/* from the same host.
TRUST_PROXY=loopback
# Transactional email (verification codes only). Defaults point to Mailpit from docker-compose.yml.
# Use an IP for local Mailpit: nodemailer resolves hostnames through DNS, and "localhost" stalled ~5 s.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Travel Rock <no-reply@travelrock.local>
# Development/test only: fixed verification code (rejected when NODE_ENV=production).
# OTP_FIXED_CODE=123456
# Development/test only: skip sending verification emails (no SMTP available). Requires OTP_FIXED_CODE.
# MAIL_DISABLED=true
