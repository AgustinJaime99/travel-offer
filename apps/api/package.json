{
  "name": "@travel-rock/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.5",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsc-watch": "^7.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@travel-rock/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "nodemailer": "10.0.13",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.5"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-dev.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:test:migrate": "dotenv run -q -f .env.test -- prisma migrate deploy",
    "lint": "eslint . --max-warnings 0",
    "staff:create-admin": "node dist/cli/create-admin.js",
    "demo:seed": "node dist/cli/seed-demo.js",
    "db:drift-check": "dotenv run -q -f .env.test -- prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  }
}
