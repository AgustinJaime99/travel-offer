# Test database from docker-compose.yml (POSTGRES_TEST_PORT, default 5441). Local-only credentials, no secrets.
NODE_ENV=test
API_PORT=3101
DATABASE_URL=postgresql://travelrock:travelrock@localhost:5441/travelrock_test
AUTH_HMAC_SECRET=test-only-secret-not-used-anywhere-else-0123456789
WEB_ORIGINS=http://localhost:3100
TRUST_PROXY=loopback
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Travel Rock <no-reply@travelrock.local>
# Short resend cooldown so E2E can sign in again right after signing up (integration tests use a fake clock).
OTP_RESEND_COOLDOWN_SECONDS=1
# Mailpit HTTP API read by the Mailpit integration test and the E2E helpers (not by the API itself).
MAILPIT_API_URL=http://127.0.0.1:8025/api/v1
# Every emailed code is 123456 in tests (forbidden in production; the email is still sent).
OTP_FIXED_CODE=123456
