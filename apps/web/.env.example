# Copy to .env.local for local development.
# Internal URL of the NestJS API; the browser reaches it through the /api/* rewrite.
# An IP, not "localhost": name resolution of localhost stalled ~5 s at times on the dev machine.
API_INTERNAL_URL=http://127.0.0.1:3001
# Post-MVP: decorative Three.js backdrop in the family onboarding ("1" enables it; inlined at build time).
NEXT_PUBLIC_ONBOARDING_3D=0
